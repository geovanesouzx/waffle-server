{
  "crons": [
    {
      "path": "/api/purge-accounts",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/baixar",
      "destination": "/api/baixar"
    },
    {
      "source": "/o/:id",
      "destination": "/api/share?t=o&id=:id"
    },
    {
      "source": "/u/:id",
      "destination": "/api/share?t=u&id=:id"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/api/share?t=assetlinks"
    }
  ]
}